{
	"name": "af-blocks",
	"version": "0.1.0",
	"private": true,
	"description": "Three custom Gutenberg blocks: Callout, FAQ and Related Posts.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php",
